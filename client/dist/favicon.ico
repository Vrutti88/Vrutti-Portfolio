<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#030609"/>
      <stop offset="100%" stop-color="#0D131B"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00FF66"/>
      <stop offset="100%" stop-color="#00E55B"/>
    </linearGradient>
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#00FF66" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- Dark Rounded Container with Neon Border -->
  <rect x="2" y="2" width="60" height="60" rx="15" fill="url(#bgGrad)" stroke="#00FF66" stroke-width="2.5" stroke-opacity="0.5"/>
  <rect x="5" y="5" width="54" height="54" rx="12" fill="none" stroke="#00FF66" stroke-width="1" stroke-opacity="0.18"/>

  <!-- Left Bracket < -->
  <path d="M 22 22 L 13 32 L 22 42" fill="none" stroke="url(#greenGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)"/>
  
  <!-- Right Bracket > -->
  <path d="M 42 22 L 51 32 L 42 42" fill="none" stroke="url(#greenGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)"/>

  <!-- Forward Slash / in White for High-Contrast Pop -->
  <path d="M 35 20 L 29 44" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>

  <!-- Live Pulse Dot -->
  <circle cx="50" cy="14" r="3" fill="#00FF66" filter="url(#neonGlow)"/>
</svg>
